# 复制到服务器 /root/www/cpdd/api/.env
# 替换成服务器上的实际值

DATABASE_URL=postgresql+asyncpg://cpdd:cpdd@localhost:5432/cpdd
REDIS_URL=redis://localhost:6379/0

# JWT 秘钥（务必改成随机长串）
JWT_SECRET=change-me-in-production

# CORS（前端会从服务器域名访问 API）
# 如果 fe 和 admin 都走 nginx 反代到同域名下，这里可以填空字符串
CORS_ORIGINS=http://localhost:5183,http://localhost:5184

# 前端 base URL（二维码登录生成扫码链接用）
WEB_BASE_URL=http://localhost:5183
